/**
 * ดึงข้อมูล Dashboard ทั้งหมด (สถิติ, รายการรับเข้า, สายทาง)
 */
function getDashboardData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // 1. ดึงข้อมูลจากชีต InputData
  const inputSheet = ss.getSheetByName('InputData');
  let records = [];
  if (inputSheet && inputSheet.getLastRow() > 1) {
    const rawData = inputSheet.getDataRange().getValues();
    const headers = rawData[0];
    
    // ค้นหา index ของแต่ละคอลัมน์
    const colIdx = {
      id: headers.findIndex(h => /ID/i.test(h)),
      route: headers.findIndex(h => /สายทาง/i.test(h)),
      dateTime: headers.findIndex(h => /วัน|เวลา/i.test(h)),
      dumpmanId: headers.findIndex(h => /Dumpman/i.test(h)),
      receiver: headers.findIndex(h => /คนรับวัสดุ/i.test(h)),
      plate: headers.findIndex(h => /ทะเบียน/i.test(h)),
      driver: headers.findIndex(h => /คนขับ/i.test(h)),
      material: headers.findIndex(h => /ประเภทวัสดุ/i.test(h)),
      quantity: headers.findIndex(h => /จำนวน/i.test(h)),
      unit: headers.findIndex(h => /หน่วย/i.test(h)),
      source: headers.findIndex(h => /แหล่ง/i.test(h)),
      startKm: headers.findIndex(h => /กม\.เริ่มต้น/i.test(h)),
      endSta: headers.findIndex(h => /สิ้นสุด/i.test(h)),
      distance: headers.findIndex(h => /ระยะทาง/i.test(h)),
      freightRate: headers.findIndex(h => /อัตราค่า/i.test(h)),
      freightCost: headers.findIndex(h => /ค่าบรรทุกรวม/i.test(h)),
      photo: headers.findIndex(h => /รูปภาพ/i.test(h)),
      file: headers.findIndex(h => /File/i.test(h))
    };

    for (let i = 1; i < rawData.length; i++) {
      const row = rawData[i];
      if (!row[colIdx.id] && !row[colIdx.route]) continue;

      let dtStr = '';
      if (row[colIdx.dateTime] instanceof Date) {
        dtStr = Utilities.formatDate(row[colIdx.dateTime], 'Asia/Bangkok', 'yyyy-MM-dd HH:mm');
      } else {
        dtStr = String(row[colIdx.dateTime] || '');
      }

      records.push({
        rowIndex: i + 1, // บรรทัดจริงใน Sheet (1-based)
        id: String(row[colIdx.id] || ''),
        route: String(row[colIdx.route] || '').trim(),
        dateTime: dtStr,
        dumpmanId: String(row[colIdx.dumpmanId] || ''),
        receiver: String(row[colIdx.receiver] || ''),
        plate: String(row[colIdx.plate] || ''),
        driver: String(row[colIdx.driver] || ''),
        material: String(row[colIdx.material] || 'ไม่ระบุ'),
        quantity: Number(row[colIdx.quantity]) || 0,
        unit: String(row[colIdx.unit] || 'ตัน'),
        source: String(row[colIdx.source] || 'ไม่ระบุแหล่ง'),
        startKm: String(row[colIdx.startKm] || ''),
        endSta: String(row[colIdx.endSta] || ''),
        distance: Number(row[colIdx.distance]) || 0,
        freightRate: Number(row[colIdx.freightRate]) || 0,
        freightCost: Number(row[colIdx.freightCost]) || 0,
        photo: String(row[colIdx.photo] || ''),
        file: String(row[colIdx.file] || '')
      });
    }
  }

  // 2. ดึงข้อมูลชีต Route
  const routeSheet = ss.getSheetByName('Route');
  let routes = [];
  if (routeSheet && routeSheet.getLastRow() > 1) {
    const routeData = routeSheet.getDataRange().getValues();
    for (let r = 1; r < routeData.length; r++) {
      const code = String(routeData[r][0] || '').trim();
      if (code) {
        routes.push({
          code: code,
          contract: String(routeData[r][1] || '-'),
          name: String(routeData[r][2] || '-')
        });
      }
    }
  }

  // 3. สรุปผลตัวเลขสถิติ (KPIs)
  let totalTons = 0;
  let totalFreight = 0;
  const materialMap = {};
  const routeMap = {};
  const driverMap = {};
  const sourceMap = {};

  records.forEach(item => {
    totalTons += item.quantity;
    totalFreight += item.freightCost;

    // แยกตามวัสดุ
    if (!materialMap[item.material]) materialMap[item.material] = { name: item.material, tons: 0, count: 0 };
    materialMap[item.material].tons += item.quantity;
    materialMap[item.material].count++;

    // แยกตามสายทาง
    if (!routeMap[item.route]) routeMap[item.route] = { code: item.route, tons: 0, count: 0 };
    routeMap[item.route].tons += item.quantity;
    routeMap[item.route].count++;

    // แยกตามคนขับ
    const dName = item.driver || 'ไม่ระบุคนขับ';
    if (!driverMap[dName]) driverMap[dName] = { driver: dName, tons: 0, count: 0, plates: {} };
    driverMap[dName].tons += item.quantity;
    driverMap[dName].count++;
    if (item.plate) driverMap[dName].plates[item.plate] = true;

    // แยกตามแหล่งรับ
    const sName = item.source || 'ไม่ระบุ';
    if (!sourceMap[sName]) sourceMap[sName] = { source: sName, tons: 0, count: 0 };
    sourceMap[sName].tons += item.quantity;
    sourceMap[sName].count++;
  });

  return {
    kpi: {
      totalDeliveries: records.length,
      totalTonnage: totalTons,
      totalFreight: totalFreight,
      routeCount: Object.keys(routeMap).length,
      driverCount: Object.keys(driverMap).length
    },
    breakdowns: {
      materials: Object.values(materialMap).sort((a, b) => b.tons - a.tons),
      routes: Object.values(routeMap).sort((a, b) => b.tons - a.tons),
      drivers: Object.values(driverMap).map(d => ({
        driver: d.driver,
        tons: d.tons,
        count: d.count,
        plates: Object.keys(d.plates)
      })).sort((a, b) => b.tons - a.tons),
      sources: Object.values(sourceMap).sort((a, b) => b.tons - a.tons)
    },
    records: records.reverse(), // แสดงล่าสุดก่อน
    routesList: routes
  };
}

/**
 * บันทึกข้อมูลการรับวัสดุใหม่เข้าชีต InputData
 */
function createReceivingRecord(formData) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('InputData');
    if (!sheet) throw new Error("ไม่พบชีต 'InputData'");

    const newId = 'RC-' + Utilities.formatDate(new Date(), 'Asia/Bangkok', 'yyMMdd') + '-' + Math.floor(1000 + Math.random() * 9000);
    const dateVal = formData.dateTime ? new Date(formData.dateTime) : new Date();

    const newRow = [
      newId,
      formData.route || '',
      dateVal,
      formData.dumpmanId || '',
      formData.receiver || '',
      formData.plate || '',
      formData.driver || '',
      formData.material || '',
      Number(formData.quantity) || 0,
      formData.unit || 'ตัน',
      formData.source || '',
      formData.startKm || '',
      formData.endSta || '',
      Number(formData.distance) || 0,
      Number(formData.freightRate) || 0,
      Number(formData.freightCost) || 0,
      formData.photo || '',
      formData.file || ''
    ];

    sheet.appendRow(newRow);
    return { success: true, message: 'บันทึกสำเร็จ รหัส: ' + newId };
  } catch (err) {
    return { success: false, message: err.toString() };
  }
}

/**
 * ลบรายการตาม Row Index
 */
function deleteReceivingRecord(rowIndex) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('InputData');
    if (!sheet) throw new Error("ไม่พบชีต 'InputData'");

    if (rowIndex > 1 && rowIndex <= sheet.getLastRow()) {
      sheet.deleteRow(rowIndex);
      return { success: true, message: 'ลบข้อมูลเรียบร้อยแล้ว' };
    }
    throw new Error('ไม่พบบรรทัดที่ต้องการลบ');
  } catch (err) {
    return { success: false, message: err.toString() };
  }
}
