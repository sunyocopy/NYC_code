    <!-- SECTION 3: ROUTES -->
    <div id="view-routes" class="hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6" id="routes-grid"></div>
    </div>
  </main>

  <!-- MODAL: ADD RECORD -->
  <div id="modal-form" class="fixed inset-0 z-50 bg-brand-dark/50 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity">
    <div class="glass-panel rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto no-scrollbar relative bg-white/80">
      <div class="flex justify-between items-center border-b border-brand-dark/10 pb-4">
        <h3 class="text-lg font-bold text-brand-orange">📝 บันทึกรับวัสดุใหม่</h3>
        <button onclick="closeModal()" class="w-8 h-8 bg-white/60 hover:bg-white/90 border border-white/60 rounded-full flex items-center justify-center text-brand-dark/60 hover:text-brand-orange transition">✕</button>
      </div>

      <form id="record-form" onsubmit="handleFormSubmit(event)" class="space-y-4 text-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div><label class="block font-semibold mb-1.5 ml-1">รหัสสายทาง <span class="text-brand-orange">*</span></label><input type="text" name="route" required class="glass-input w-full px-4 py-3 rounded-xl" /></div>
          <div><label class="block font-semibold mb-1.5 ml-1">ประเภทวัสดุ <span class="text-brand-orange">*</span></label><input type="text" name="material" required class="glass-input w-full px-4 py-3 rounded-xl" /></div>
          <div><label class="block font-semibold mb-1.5 ml-1">ปริมาณวัสดุ <span class="text-brand-orange">*</span></label><input type="number" step="any" name="quantity" required class="glass-input w-full px-4 py-3 rounded-xl" /></div>
          <div><label class="block font-semibold mb-1.5 ml-1">หน่วยนับ</label><input type="text" name="unit" value="ตัน" class="glass-input w-full px-4 py-3 rounded-xl" /></div>
          <div><label class="block font-semibold mb-1.5 ml-1">ชื่อคนขับรถ</label><input type="text" name="driver" class="glass-input w-full px-4 py-3 rounded-xl" /></div>
          <div><label class="block font-semibold mb-1.5 ml-1">ทะเบียนรถ</label><input type="text" name="plate" class="glass-input w-full px-4 py-3 rounded-xl" /></div>
          <div class="sm:col-span-2"><label class="block font-semibold mb-1.5 ml-1">แหล่งรับวัสดุ</label><input type="text" name="source" class="glass-input w-full px-4 py-3 rounded-xl" /></div>
          <div><label class="block font-semibold mb-1.5 ml-1">ผู้รับวัสดุ</label><input type="text" name="receiver" class="glass-input w-full px-4 py-3 rounded-xl" /></div>
          <div><label class="block font-semibold mb-1.5 ml-1">ค่าบรรทุก (บาท)</label><input type="number" step="any" name="freightCost" class="glass-input w-full px-4 py-3 rounded-xl" /></div>
        </div>
        <div class="flex justify-end gap-3 pt-5 border-t border-brand-dark/10 mt-4">
          <button type="button" onclick="closeModal()" class="px-5 py-3 rounded-xl text-brand-dark/80 bg-white/60 hover:bg-white/90 border border-white/60 transition font-medium">ยกเลิก</button>
          <button type="submit" id="submit-btn" class="px-6 py-3 bg-brand-orange hover:bg-[#d64b2a] text-white font-bold rounded-xl shadow-lg shadow-brand-orange/30 transition transform hover:-translate-y-0.5">บันทึกข้อมูล</button>
        </div>
      </form>
    </div>
  </div>

  <!-- SCRIPT FRONTEND LOGIC -->
  <script>
    let appData = { kpi: {}, breakdowns: {}, records: [], routesList: [] };
    let chart1, chart2, chart3; 

    // ลงทะเบียน Plugin สำหรับแสดง DataLabels
    Chart.register(ChartDataLabels);
    Chart.defaults.font.family = "'Prompt', sans-serif";
    Chart.defaults.color = "#272A2D";

    const chartColors = [
      '#EB5B38', // ส้ม
      '#347CCB', // ฟ้า
      '#272A2D', // ดำ/เทาเข้ม
      '#F49D85', // ส้มอ่อน
      '#7AAAE1', // ฟ้าอ่อน
      '#555B61'  // เทากลาง
    ];

    window.onload = function() { fetchDashboard(); };

    function fetchDashboard() {
      google.script.run
        .withSuccessHandler(function(response) {
          appData = response;
          renderDashboard();
          document.getElementById('loading').classList.add('hidden');
          document.getElementById('main-content').classList.remove('hidden');
        })
        .withFailureHandler(function(err) {
          Swal.fire({ icon: 'error', title: 'ไม่สามารถโหลดข้อมูลได้', text: err, customClass: { popup: 'custom-swal' } });
        })
        .getDashboardData();
    }

    function renderDashboard() {
      document.getElementById('kpi-tons').innerText = Number(appData.kpi.totalTonnage || 0).toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 2});
      document.getElementById('kpi-deliveries').innerText = Number(appData.kpi.totalDeliveries || 0).toLocaleString();
      document.getElementById('kpi-routes').innerText = Number(appData.kpi.routeCount || 0).toLocaleString();
      document.getElementById('kpi-freight').innerText = '฿' + Number(appData.kpi.totalFreight || 0).toLocaleString();

      const matDiv = document.getElementById('material-list');
      matDiv.innerHTML = '';
      appData.breakdowns.materials.forEach(m => {
        const pct = appData.kpi.totalTonnage > 0 ? ((m.tons / appData.kpi.totalTonnage) * 100).toFixed(1) : 0;
        matDiv.innerHTML += `
          <div class="mb-4 last:mb-0">
            <div class="flex justify-between items-center text-sm font-semibold mb-2">
              <span>${m.name}</span>
              <span class="text-brand-orange bg-white/80 border border-white/90 px-2.5 py-1 rounded-lg text-xs shadow-sm">${m.tons.toLocaleString()} ตัน <span class="text-brand-dark/50 ml-1">${pct}%</span></span>
            </div>
            <div class="w-full bg-white/50 rounded-full h-3 shadow-inner overflow-hidden border border-white/60">
              <div class="bg-gradient-to-r from-[#ff7a59] to-brand-orange h-full rounded-full transition-all duration-1000" style="width: ${pct}%"></div>
            </div>
          </div>
        `;
      });

      const rtDiv = document.getElementById('route-list');
      rtDiv.innerHTML = '';
      appData.breakdowns.routes.forEach(r => {
        const pct = appData.kpi.totalTonnage > 0 ? ((r.tons / appData.kpi.totalTonnage) * 100).toFixed(1) : 0;
        rtDiv.innerHTML += `
          <div class="p-4 bg-white/50 rounded-2xl border border-white/70 mb-3 last:mb-0 shadow-sm hover:bg-white/70 transition">
            <div class="flex justify-between items-center text-sm font-semibold mb-2">
              <span class="text-brand-blue bg-brand-blue/10 px-3 py-1 rounded-lg border border-brand-blue/20">${r.code}</span>
              <span>${r.tons.toLocaleString()} ตัน</span>
            </div>
            <div class="w-full bg-white/60 rounded-full h-2 mb-2 shadow-inner overflow-hidden border border-white/60">
              <div class="bg-brand-blue h-full rounded-full" style="width: ${pct}%"></div>
            </div>
          </div>
        `;
      });

      const srcDiv = document.getElementById('source-list');
      srcDiv.innerHTML = '';
      appData.breakdowns.sources.forEach(s => {
        srcDiv.innerHTML += `
          <div class="flex justify-between items-center p-3.5 rounded-xl bg-white/50 border border-white/70 mb-3 last:mb-0 shadow-sm text-sm">
            <span class="font-medium flex items-center gap-2">📍 ${s.source}</span>
            <span class="font-bold bg-white/80 px-3 py-1.5 rounded-lg border border-white/60">${s.tons.toLocaleString()} ตัน</span>
          </div>
        `;
      });
      
      // การตั้งค่า ChartOptions รวมถึง DataLabels
      const chartOptions = {
        responsive: true, 
        maintainAspectRatio: false, 
        cutout: '65%',
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 12, padding: 15 } },
          tooltip: {
            callbacks: {
              label: function(context) {
                const value = context.raw || 0;
                const total = context.chart._metasets[context.datasetIndex].total;
                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                return ` ${context.label}: ${value.toLocaleString()} ตัน (${percentage}%)`;
              }
            }
          },
          datalabels: {
            color: '#ffffff', // สีตัวหนังสือบนกราฟ
            font: { weight: 'bold', size: 12 },
            formatter: (value, ctx) => {
              const dataArr = ctx.chart.data.datasets[0].data;
              const total = dataArr.reduce((a, b) => a + b, 0);
              if (total === 0) return '';
              const percentage = (value * 100 / total).toFixed(1);
              // ซ่อน Label หากเปอร์เซ็นต์น้อยกว่า 5% เพื่อไม่ให้ข้อความซ้อนกัน
              return percentage > 5 ? percentage + '%' : '';
            }
          }
        }
      };

      const ctxMat = document.getElementById('materialChart').getContext('2d');
      if(chart1) chart1.destroy();
      chart1 = new Chart(ctxMat, { type: 'doughnut', data: { labels: appData.breakdowns.materials.map(m => m.name), datasets: [{ data: appData.breakdowns.materials.map(m => m.tons), backgroundColor: chartColors, borderWidth: 2, borderColor: '#E6E4DC' }] }, options: chartOptions });

      const ctxRt = document.getElementById('routeChart').getContext('2d');
      if(chart2) chart2.destroy();
      chart2 = new Chart(ctxRt, { type: 'doughnut', data: { labels: appData.breakdowns.routes.map(r => r.code), datasets: [{ data: appData.breakdowns.routes.map(r => r.tons), backgroundColor: chartColors, borderWidth: 2, borderColor: '#E6E4DC' }] }, options: chartOptions });

      const ctxSrc = document.getElementById('sourceChart').getContext('2d');
      if(chart3) chart3.destroy();
      chart3 = new Chart(ctxSrc, { type: 'doughnut', data: { labels: appData.breakdowns.sources.map(s => s.source), datasets: [{ data: appData.breakdowns.sources.map(s => s.tons), backgroundColor: chartColors, borderWidth: 2, borderColor: '#E6E4DC' }] }, options: chartOptions });

      const matSelect = document.getElementById('filter-material');
      matSelect.innerHTML = '<option value="ALL">📦 ทุกประเภทวัสดุ</option>';
      appData.breakdowns.materials.forEach(m => matSelect.innerHTML += `<option value="${m.name}">${m.name}</option>`);

      const rtSelect = document.getElementById('filter-route');
      rtSelect.innerHTML = '<option value="ALL">📍 ทุกสายทาง</option>';
      appData.breakdowns.routes.forEach(r => rtSelect.innerHTML += `<option value="${r.code}">${r.code}</option>`);

      const rGrid = document.getElementById('routes-grid');
      rGrid.innerHTML = '';
      appData.routesList.forEach(r => {
        rGrid.innerHTML += `
          <div class="glass-panel p-6 rounded-3xl hover:shadow-xl hover:bg-white/70 transition flex flex-col group border border-white/70">
            <div class="self-start px-3.5 py-1.5 rounded-xl text-sm font-bold bg-brand-orange text-white shadow-sm mb-4">${r.code}</div>
            <h3 class="font-bold text-lg">${r.name}</h3>
            <div class="mt-auto pt-5"><p class="text-sm bg-white/60 rounded-lg p-3">สัญญา: <span class="font-medium">${r.contract}</span></p></div>
          </div>
        `;
      });

      renderTable();
    }

    function renderTable() {
      const q = (document.getElementById('search-input').value || '').toLowerCase();
      const fMat = document.getElementById('filter-material').value;
      const fRt = document.getElementById('filter-route').value;
      const tbody = document.getElementById('table-body');
      tbody.innerHTML = '';

      const filtered = appData.records.filter(r => {
        if (fMat !== 'ALL' && r.material !== fMat) return false;
        if (fRt !== 'ALL' && r.route !== fRt) return false;
        if (q) return r.id.toLowerCase().includes(q) || r.route.toLowerCase().includes(q) || r.material.toLowerCase().includes(q);
        return true;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="text-center py-10 font-medium">📭 ไม่พบรายการข้อมูลที่ค้นหา</td></tr>`;
        return;
      }

      filtered.forEach(item => {
        tbody.innerHTML += `
          <tr class="hover:bg-white/60 border-b border-white/40 transition">
            <td class="py-4 px-5 font-mono whitespace-nowrap"><div class="font-bold">${item.id}</div><div class="text-xs opacity-60">${item.dateTime}</div></td>
            <td class="py-4 px-5 whitespace-nowrap"><span class="px-3 py-1.5 rounded-lg font-bold bg-brand-orange/10 text-brand-orange border border-brand-orange/20">${item.route}</span></td>
            <td class="py-4 px-5 font-medium whitespace-nowrap">${item.material}</td>
            <td class="py-4 px-5 text-right font-bold whitespace-nowrap">${item.quantity} ${item.unit}</td>
            <td class="py-4 px-5 whitespace-nowrap">${item.driver || '-'} <br><span class="text-xs bg-white/70 px-1 rounded">${item.plate || '-'}</span></td>
            <td class="py-4 px-5 whitespace-nowrap">${item.source}</td>
            <td class="py-4 px-5 text-right font-bold text-brand-orange whitespace-nowrap">฿${item.freightCost.toLocaleString()}</td>
            <td class="py-4 px-5 text-center whitespace-nowrap">
              <button onclick="deleteRecord(${item.rowIndex})" class="text-rose-500 hover:bg-white/70 px-3 py-2 rounded-xl transition font-medium">ลบ</button>
            </td>
          </tr>
        `;
      });
    }

    function switchTab(tab) {
      ['overview', 'records', 'routes'].forEach(t => {
        document.getElementById('view-' + t).classList.add('hidden');
        document.getElementById('tab-btn-' + t).className = "shrink-0 px-5 py-2.5 rounded-xl text-sm font-medium text-brand-dark/70 bg-white/40 hover:bg-white/70 border border-white/50 shadow-sm transition";
      });
      document.getElementById('view-' + tab).classList.remove('hidden');
      document.getElementById('tab-btn-' + tab).className = "shrink-0 px-5 py-2.5 rounded-xl text-sm font-bold text-brand-orange bg-white/80 border border-brand-orange/30 shadow-sm backdrop-blur-md transition";
    }

    function openModal() {
      const modal = document.getElementById('modal-form');
      modal.classList.remove('hidden'); modal.classList.add('flex');
    }
    function closeModal() {
      const modal = document.getElementById('modal-form');
      modal.classList.add('hidden'); modal.classList.remove('flex');
    }

    function handleFormSubmit(e) {
      e.preventDefault();
      const form = document.getElementById('record-form');
      const formData = {
        route: form.route.value, material: form.material.value, quantity: form.quantity.value,
        unit: form.unit.value, driver: form.driver.value, plate: form.plate.value,
        source: form.source.value, receiver: form.receiver.value, freightCost: form.freightCost.value
      };
      const btn = document.getElementById('submit-btn');
      btn.innerText = 'กำลังบันทึก...'; btn.disabled = true;

      google.script.run.withSuccessHandler(function(res) {
        btn.innerText = 'บันทึกข้อมูล'; btn.disabled = false;
        if (res.success) {
          form.reset(); closeModal();
          Swal.fire({ icon: 'success', title: 'บันทึกสำเร็จ!', showConfirmButton: false, timer: 1500, customClass: { popup: 'custom-swal' } });
          fetchDashboard(); 
        } else Swal.fire({ icon: 'error', title: 'ผิดพลาด', text: res.message, customClass: { popup: 'custom-swal' }, confirmButtonColor: '#EB5B38' });
      }).createReceivingRecord(formData);
    }

    function deleteRecord(rowIndex) {
      Swal.fire({
        title: 'ยืนยันการลบ?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', 
        cancelButtonColor: '#272A2D', confirmButtonText: 'ลบเลย!', cancelButtonText: 'ยกเลิก', customClass: { popup: 'custom-swal' }
      }).then((result) => {
        if (result.isConfirmed) {
          Swal.fire({ title: 'กำลังลบ...', allowOutsideClick: false, showConfirmButton: false, didOpen: () => Swal.showLoading() });
          google.script.run.withSuccessHandler(function(res) {
            if (res.success) {
              Swal.fire({ icon: 'success', title: 'ลบเรียบร้อย!', showConfirmButton: false, timer: 1500, customClass: { popup: 'custom-swal' } });
              fetchDashboard();
            } else Swal.fire({ icon: 'error', title: 'ลบไม่สำเร็จ', text: res.message, confirmButtonColor: '#EB5B38' });
          }).deleteReceivingRecord(rowIndex);
        }
      });
    }
  </script>
</body>
</html>
